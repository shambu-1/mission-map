# Optional: copy to backend/.env and adjust. The defaults below match scripts/setup_db.py.
DATABASE_URL=postgresql+asyncpg://missionmap:missionmap@localhost:5432/missionmap
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
CORS_ORIGINS=["http://localhost:4200"]

# Proof photos: leave S3_BUCKET empty to store on local disk (./uploads)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Daily random events pull POIs from OpenStreetMap
OVERPASS_URL=https://overpass-api.de/api/interpreter
