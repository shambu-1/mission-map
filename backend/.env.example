# Optional: copy to backend/.env and adjust. The defaults below match scripts/setup_db.py.
DATABASE_URL=postgresql+asyncpg://missionmap:missionmap@localhost:5432/missionmap

# development | production. In production the API refuses to start unless JWT_SECRET is
# set to a random string of 32+ characters, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
CORS_ORIGINS=["http://localhost:4200"]

# Proof photos: leave S3_BUCKET empty to store on local disk (./uploads)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Daily random events pull POIs from OpenStreetMap
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Rate limits are kept in memory by default. With more than one API instance, use Redis
# (pip install redis):  RATE_LIMIT_STORAGE_URI=redis://localhost:6379
RATE_LIMIT_STORAGE_URI=memory://

# Behind a hosting proxy/load balancer, let uvicorn trust its X-Forwarded-For header:
# uvicorn app.main:app --proxy-headers   and   FORWARDED_ALLOW_IPS=<proxy IP or range>
